<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferreteria.ferreteriapro.LoginController" spacing="15" alignment="CENTER" prefWidth="400" prefHeight="500" style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #4ca1af);">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>
    <Label text="Sistema de Inventario" style="-fx-font-size: 24px; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
    <Label text="Ferretería Pro" style="-fx-font-size: 14px; -fx-text-fill: #ecf0f1;" />
    
    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Usuario" style="-fx-text-fill: white;" />
        <TextField fx:id="txtUsuario" promptText="Usuario" style="-fx-pref-height: 35px;" />
    </VBox>
    
    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Contraseña" style="-fx-text-fill: white;" />
        <PasswordField fx:id="txtPassword" promptText="Contraseña" style="-fx-pref-height: 35px;" />
    </VBox>
    
    <Button text="Ingresar" onAction="#onLoginClick" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150px; -fx-pref-height: 40px; -fx-cursor: hand;" />
    <Label fx:id="lblMensaje" text="" style="-fx-text-fill: #ff7675; -fx-font-weight: bold;" wrapText="true" />
</VBox>
