<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ferreteria.ferreteriapro.HelloController"
      stylesheets="@styles.css"
      styleClass="main-app-container"
      spacing="12.0">

    <!-- ======================================================================
         BARRA DE ENCABEZADO SUPERIOR (HEADER ESTILO ENTERPRISE POS)
         ====================================================================== -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="16.0">
        <!-- Logo y Marca -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                <image>
                    <Image url="@icon.png"/>
                </image>
            </ImageView>
            <Label text="Ferretería Pro" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0b1c30;"/>
            <Label text="ENTERPRISE POS" styleClass="brand-badge"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Info de Usuario y Sesión -->
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-status-pill">
            <Label text="●" style="-fx-text-fill: #059669; -fx-font-size: 10px;"/>
            <Label fx:id="lblSesionInfo" text="👤 Usuario: [Nombre] | Rol: [Rol]" style="-fx-font-weight: bold; -fx-text-fill: #0b1c30; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Botón de Cerrar Sesión -->
        <Button text="🚪 Cerrar Sesión" onAction="#onLogoutClick" styleClass="btn-logout"/>
    </HBox>

    <!-- ======================================================================
         CONTENEDOR PRINCIPAL CON PESTAÑAS (TABPANE MODERNO)
         ====================================================================== -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 16px 16px 16px;">
        <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <!-- ==========================================================
                     PESTAÑA 1: VENTAS (POS)
                     ========================================================== -->
                <Tab text="🛒 Ventas">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <!-- Barra de herramientas de ventas -->
                        <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="card-panel-compact">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label text="PUNTO DE VENTA - BÚSQUEDA RÁPIDA DE PRODUCTOS"
                                       style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI Semibold';"/>
                                <TextField fx:id="txtBuscador" promptText="🔍 Escribe código, nombre o referencia del producto..."
                                           styleClass="search-field"/>
                            </VBox>

                            <HBox spacing="10.0" alignment="BOTTOM_CENTER">
                                <Button fx:id="btnSalida" text="💰 REALIZAR VENTA" onAction="#onSalidaClick"
                                        styleClass="btn-pos-sale"/>
                                <Button text="🪟 NUEVA VENTA (FLOTANTE)" onAction="#onNuevaVentaFlotanteClick"
                                        styleClass="btn-pos-float"/>
                            </HBox>
                        </HBox>

                        <!-- Tabla de productos en venta -->
                        <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="90" />
                                <TableColumn fx:id="colNombre" text="DESCRIPCIÓN DEL PRODUCTO" prefWidth="250" />
                                <TableColumn fx:id="colPrecio" text="PRECIO VENTA" prefWidth="120" />
                                <TableColumn fx:id="colStock" text="STOCK DISPONIBLE" prefWidth="110" />
                                <TableColumn fx:id="colProveedor" text="PROVEEDOR" prefWidth="150" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- ==========================================================
                     PESTAÑA 2: GESTIÓN DE PRODUCTOS
                     ========================================================== -->
                <Tab fx:id="tabGestion" text="🛠️ Gestión de Productos">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <!-- Panel de Selección rápida -->
                        <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="toolbar-panel">
                            <Label text="Seleccionar producto existente:" style="-fx-font-weight: bold; -fx-text-fill: #0b1c30;"/>
                            <org.controlsfx.control.SearchableComboBox fx:id="comboBusquedaGestion"
                                                                     promptText="Escriba el nombre o código del producto..."
                                                                     HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Refrescar Formulario" onAction="#limpiarCampos" styleClass="btn-secondary"/>
                        </HBox>

                        <!-- Formulario de edición/creación en tarjeta -->
                        <VBox spacing="16.0" styleClass="card-panel">
                            <Label text="Registro y Modificación de Artículos de Catálogo" styleClass="section-header-title"/>
                            
                            <GridPane hgap="16.0" vgap="14.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="220.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="220.0" />
                                </columnConstraints>
                                <children>
                                    <Label text="Código (ART-XXX):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 600;"/>
                                    <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    
                                    <Label text="Nombre del Producto:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: 600;"/>
                                    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                    
                                    <Label text="Costo de Compra ($):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 600;"/>
                                    <TextField fx:id="txtPrecioCompra" promptText="0.00" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    
                                    <Label text="\% Margen Ganancia:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: 600;"/>
                                    <TextField fx:id="txtPorcentajeGanancia" text="30" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                                    
                                    <Label text="\% IVA Aplicable:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: 600;"/>
                                    <TextField fx:id="txtPorcentajeIva" text="19" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                    
                                    <Label text="Precio Venta Final:" GridPane.rowIndex="2" GridPane.columnIndex="2"
                                           style="-fx-font-weight: bold; -fx-text-fill: #4b41e1; -fx-font-size: 13px;"/>
                                    <TextField fx:id="txtPrecio" editable="false"
                                               style="-fx-background-color: #eff4ff; -fx-text-fill: #4b41e1; -fx-font-weight: bold; -fx-font-size: 14px;"
                                               GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                                    
                                    <Label text="Stock Inicial:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: 600;"/>
                                    <TextField fx:id="txtStock" text="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                    
                                    <Label text="Proveedor Asignado:" GridPane.rowIndex="3" GridPane.columnIndex="2" style="-fx-font-weight: 600;"/>
                                    <org.controlsfx.control.SearchableComboBox fx:id="comboProveedorGestion"
                                                                             promptText="Seleccionar proveedor..."
                                                                             GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                                </children>
                            </GridPane>

                            <Separator />

                            <!-- Botones de acción del formulario -->
                            <HBox spacing="12.0" alignment="CENTER_RIGHT">
                                <Button text="➕ Nuevo Producto" onAction="#onNuevoProductoClick" styleClass="btn-primary"/>
                                <Button text="🗑️ Eliminar Producto" onAction="#onEliminarClick" styleClass="btn-danger"/>
                                <Button text="💾 Guardar Cambios" onAction="#onGuardarClick" styleClass="btn-success"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- ==========================================================
                     PESTAÑA 3: HISTORIAL DE VENTAS
                     ========================================================== -->
                <Tab fx:id="tabHistorialVentas" text="📊 Historial de Ventas" onSelectionChanged="#actualizarHistorial">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="card-panel-compact">
                            <VBox spacing="2.0">
                                <Label text="Registro de Ventas Realizadas" styleClass="section-header-title"/>
                                <Label text="Control de transacciones, estados de caja y arqueos" styleClass="section-header-desc"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="💰 Cerrar Caja Hoy" onAction="#onCerrarCajaClick" styleClass="btn-warning"/>
                            <Button text="📈 Reporte Mensual" onAction="#onReporteMensualClick" styleClass="btn-accent-purple"/>
                            <Button text="📊 Ganancias Totales" onAction="#onReporteGananciasClick" styleClass="btn-success"/>
                            <Button text="↩️ Revertir Venta" onAction="#onRevertirVentaClick" styleClass="btn-danger"/>
                        </HBox>

                        <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colVentaId" text="ID" prefWidth="60" />
                                <TableColumn fx:id="colVentaFecha" text="FECHA / HORA" prefWidth="140" />
                                <TableColumn fx:id="colVentaProducto" text="PRODUCTO" prefWidth="180" />
                                <TableColumn fx:id="colVentaCant" text="CANT." prefWidth="70" />
                                <TableColumn fx:id="colVentaTotal" text="TOTAL ($)" prefWidth="110" />
                                <TableColumn fx:id="colVentaMetodo" text="MÉTODO PAGO" prefWidth="110" />
                                <TableColumn fx:id="colVentaUsuario" text="CAJERO" prefWidth="120" />
                                <TableColumn fx:id="colVentaEstado" text="ESTADO" prefWidth="100" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- ==========================================================
                     PESTAÑA 4: HISTORIAL DE COMPRAS
                     ========================================================== -->
                <Tab fx:id="tabHistorialCompras" text="📦 Historial de Compras" onSelectionChanged="#actualizarHistorialCompras">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-panel-compact">
                            <VBox spacing="2.0">
                                <Label text="Registro de Entradas de Mercancía" styleClass="section-header-title"/>
                                <Label text="Lotes adquiridos a proveedores y actualización de costos" styleClass="section-header-desc"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="➕ Registrar Nueva Compra" onAction="#onEntradaClick" styleClass="btn-primary"/>
                            <Button text="✏️ Editar Registro" onAction="#onEditarEntradaClick" styleClass="btn-warning"/>
                            <Button text="📦 Cierre Mensual (Archivar)" onAction="#onCierreMensualClick" styleClass="btn-secondary"/>
                        </HBox>

                        <TableView fx:id="tablaEntradas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colEntradaId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colEntradaFecha" text="FECHA RECEPCIÓN" prefWidth="130"/>
                                <TableColumn fx:id="colEntradaProducto" text="PRODUCTO" prefWidth="220"/>
                                <TableColumn fx:id="colEntradaCant" text="CANTIDAD" prefWidth="90"/>
                                <TableColumn fx:id="colEntradaCosto" text="COSTO UNIT." prefWidth="110"/>
                                <TableColumn fx:id="colEntradaProveedor" text="PROVEEDOR" prefWidth="160"/>
                                <TableColumn fx:id="colEntradaUsuario" text="RESPONSABLE" prefWidth="130"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- ==========================================================
                     PESTAÑA 5: CARTERA / CLIENTES
                     ========================================================== -->
                <Tab fx:id="tabCartera" text="📒 Cartera / Clientes" onSelectionChanged="#actualizarListaClientes">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-panel-compact">
                            <VBox spacing="2.0">
                                <Label text="Gestión de Cartera y Clientes a Crédito" styleClass="section-header-title"/>
                                <Label text="Control de saldos deudores, líneas de crédito y abonos" styleClass="section-header-desc"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtBuscadorCliente" promptText="🔍 Buscar por nombre o cédula..." styleClass="search-field" prefWidth="220"/>
                            <Button text="➕ Nuevo Cliente" onAction="#onNuevoClienteClick" styleClass="btn-primary"/>
                            <Button text="💳 Registrar Abono" onAction="#onRegistrarAbonoClick" styleClass="btn-success"/>
                            <Button text="📄 Historial de Abonos" onAction="#onVerHistorialAbonosClick" styleClass="btn-accent-purple"/>
                        </HBox>

                        <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colClienteId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colClienteDoc" text="DOCUMENTO / CÉDULA" prefWidth="140"/>
                                <TableColumn fx:id="colClienteNombre" text="NOMBRE COMPLETO" prefWidth="260"/>
                                <TableColumn fx:id="colClienteTel" text="TELÉFONO" prefWidth="130"/>
                                <TableColumn fx:id="colClienteSaldo" text="SALDO PENDIENTE ($)" prefWidth="160"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- ==========================================================
                     PESTAÑA 6: USUARIOS
                     ========================================================== -->
                <Tab fx:id="tabUsuarios" text="👥 Usuarios" onSelectionChanged="#actualizarListaUsuarios">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <VBox spacing="14.0" styleClass="card-panel">
                            <Label text="Gestión de Accesos, Operadores y Roles del Sistema" styleClass="section-header-title"/>
                            
                            <GridPane hgap="16.0" vgap="12.0" styleClass="toolbar-panel">
                                <Label text="Nombre Completo:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 600;"/>
                                <TextField fx:id="txtUsuarioNombre" promptText="Ej: Juan Pérez" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                
                                <Label text="Nombre de Usuario (Login):" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: 600;"/>
                                <TextField fx:id="txtUsuarioLogin" promptText="Ej: jperez" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                
                                <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 600;"/>
                                <PasswordField fx:id="txtUsuarioPass" promptText="Nueva contraseña" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                
                                <Label text="Rol Asignado:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: 600;"/>
                                <ComboBox fx:id="comboUsuarioRol" promptText="Seleccionar rol..." GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity"/>
                                
                                <HBox spacing="10.0" alignment="CENTER_RIGHT" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4" style="-fx-padding: 8 0 0 0;">
                                    <Button text="Limpiar Formulario" onAction="#limpiarCamposUsuario" styleClass="btn-secondary"/>
                                    <Button text="🗑️ Eliminar Usuario" onAction="#onEliminarUsuarioClick" styleClass="btn-danger"/>
                                    <Button text="💾 Guardar / Actualizar" onAction="#onGuardarUsuarioClick" styleClass="btn-success"/>
                                </HBox>
                            </GridPane>
                        </VBox>

                        <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUsuarioId" text="ID" prefWidth="60" />
                                <TableColumn fx:id="colUsuarioFull" text="NOMBRE COMPLETO" prefWidth="280" />
                                <TableColumn fx:id="colUsuarioNick" text="USERNAME (LOGIN)" prefWidth="180" />
                                <TableColumn fx:id="colUsuarioRol" text="ROL ASIGNADO" prefWidth="160" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- ==========================================================
                     PESTAÑA 7: PROVEEDORES
                     ========================================================== -->
                <Tab fx:id="tabProveedores" text="🤝 Proveedores" onSelectionChanged="#actualizarListaProveedores">
                    <VBox spacing="14.0" style="-fx-padding: 16px 0 0 0;">
                        <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="card-panel-compact">
                            <Label text="Nombre del Proveedor:" style="-fx-font-weight: bold; -fx-text-fill: #0b1c30;"/>
                            <TextField fx:id="txtNombreProveedor" promptText="Ej: Aceros S.A., Distribuidora Ferretera..." HBox.hgrow="ALWAYS"/>
                            <Button text="💾 Guardar" onAction="#onGuardarProveedorClick" styleClass="btn-success"/>
                            <Button text="🗑️ Eliminar" onAction="#onEliminarProveedorClick" styleClass="btn-danger"/>
                            <Button text="➕ Nuevo" onAction="#limpiarCamposProveedor" styleClass="btn-secondary"/>
                        </HBox>

                        <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProvId" text="ID" prefWidth="80" />
                                <TableColumn fx:id="colProvNombre" text="RAZÓN SOCIAL / NOMBRE DEL PROVEEDOR" prefWidth="450" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

            </tabs>
        </TabPane>
    </VBox>

</VBox>